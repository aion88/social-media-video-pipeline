# apparaît plus tard (motion rendu) recale l'étape, statut le dit. L'étalonnage n'est plus sauté.
SAUTEES = {"motion": "pas demandé, /sm-motion le fait"}

VIDEO = (".mov", ".mp4", ".m4v")
SUFFIXES = (".derush.mp4", ".reel.mp4", ".logos.mp4", ".motion.mp4", ".repare.mp4", ".overlays.mp4", ".fcpxml")
