# ---- Nouvelle chaîne : avec ETAT.json ----

def recaler(d, stem, etat):
    """ETAT.json comparé aux fichiers. Rend (étapes recalées, retards, périmées). N'écrit rien."""
    etapes = {e: dict(v) for e, v in etat["etapes"].items()}
    retards, perimees = [], {}
    for e, noms in PREUVES.items():
        vus = [(quand(d / n.format(stem=stem)), n.format(stem=stem)) for n in noms]
        vus = [(t, n) for t, n in vus if t]
        if not vus:
            continue
        t, nom = max(vus)
        fait = horodatage(etapes[e]["fait"])
        if fait is None or t > fait + TOLERANCE:
            dit = f"ETAT.json dit {etapes[e]['fait']}" if etapes[e]["fait"] else "pas dans ETAT.json"
            retards.append(f"{e} ({nom} du {datetime.fromtimestamp(t):%Y-%m-%d %H:%M}, {dit})")
            etapes[e] = {"fait": datetime.fromtimestamp(t).astimezone().isoformat(timespec="seconds"),
                         "mesures": {"recale": nom}, "valide": e not in A_VALIDER or nom.endswith(".reel.mp4")}  # .reel.mp4 = derush export, donc coupes déjà validées
    # Le look est fixé une fois pour toutes : LOOK.json le prouve pour chaque vidéo, sans date à comparer.
    l = etapes["look"]
    # Un ancien ETAT.json la marque « sautée » (posée par overlays.py) : sans LOOK.json, elle redevient à faire.
    if not l["fait"] or l["mesures"].get("saute"):
        if LOOK_JSON.exists():
            etapes["look"] = {"fait": datetime.fromtimestamp(quand(LOOK_JSON)).astimezone().isoformat(timespec="seconds"),
                              "mesures": {"recale": "outils/looks/LOOK.json"}, "valide": True}
        else:
            etapes["look"] = {"fait": None, "mesures": {}, "valide": False}
    # Une étape plus ancienne qu'une étape d'avant est périmée : un re-montage refait l'export.
    avant = None
    for e in ETAPES:
        v = etapes[e]
        t = horodatage(v["fait"])
        if t is None or v["mesures"].get("saute") or (e == "look" and v["mesures"].get("recale")):
            continue
        if avant and t + TOLERANCE < avant[1]:
            perimees[e] = avant[0]
            etapes[e] = {"fait": None, "mesures": {}, "valide": False}
            continue
        avant = (e, t)
    return etapes, retards, perimees


def lecture_etat(d, stem, t, etat, ref):
    nom = shlex.quote(stem)
    etapes, retards, perimees = recaler(d, stem, etat)
    fait, reste, cible = [], [], None
    for e in ETAPES:
        v, m = etapes[e], etapes[e]["mesures"]
        n = NOMS.get(e, e)
        if m.get("saute"):
            fait.append(f"{n} sautée ({m['saute']})")
        elif v["fait"]:
            quoi = f"{n} {(v['fait'] or '')[:10]}" + (f" (recalé sur {m['recale']})" if m.get("recale") else "")
            fait.append(quoi + ("" if v["valide"] else ", à valider"))
            if not v["valide"] and cible is None and e not in OPTIONNELLES:
                cible = ("valider", e)
        elif e in OPTIONNELLES:
            reste.append(f"{n} ({OPTION_TXT})")
        else:
            reste.append(n + (f" (à refaire : plus ancienne que {perimees[e]})" if e in perimees else ""))
            if cible is None:
                cible = ("faire", e)
    if cible is None:
        fini, resume, geste, suite = True, f"finie le {etapes['export']['fait'][:10]}, à publier", "publier (rien ne part tout seul)", FIN
    else:
        fini = False
        quoi, e = cible
        if quoi == "valider":
            resume = f"{NOMS.get(e, e)} fait, attend ta validation"
            geste = GESTE.get(e, f"valider {e}").format(stem=stem)
            if e == "montage" and t["fcpxml"]:
                geste += f", ou {stem}.fcpxml dans DaVinci"
            apres = next((x for x in ETAPES[ETAPES.index(e) + 1:]
                          if x not in OPTIONNELLES and not etapes[x]["fait"] and not etapes[x]["mesures"].get("saute")), None)
            suite = f"après ton OK (outils/video valide {nom} {e}) : " + (commande(apres, t, ref, nom) if apres else FIN)
        else:
            resume, geste, suite = f"{NOMS.get(e, e)} à faire", "rien de toi pour l'instant", commande(e, t, ref, nom)
    if retards:
        ligne = "ETAT.json en retard sur les fichiers : " + " ; ".join(retards) + ". État recalé sur les fichiers, rien écrit"
    else:
        ligne = "état : ETAT.json, d'accord avec les fichiers"
    return {"resume": resume, "fini": fini, "fait": fait, "reste": reste, "geste": geste, "suite": suite,
            "etat": ligne, "liens": liens(etat)}


def commande(e, t, ref, nom):
    if e == "montage":
        return suite_montage(t, ref) or f"/sm-montage {ref}"
    if e in OPTIONNELLES:
        return OPTION_TXT
    if e in ("look", "overlays") and not t["reel"]:
        return f"derush export {ref} (le montage à -14 LUFS), puis {SUITE[e].format(nom=nom)}"
    return SUITE[e].format(ref=ref, nom=nom)


def liens(etat):
    morceaux = []
    if etat.get("source_origine"):
        morceaux.append(f"venue de {etat['source_origine']}")
    if etat.get("recherche"):
        morceaux.append(f"recherche {etat['recherche']}")
    return "liens : " + " ; ".join(morceaux) if morceaux else None


# ---- valide et export : les deux écrivains d'aujourd'hui ----

def depuis_fichiers(d, stem, jusqua):
    """Premier ETAT.json d'une vidéo commencée sans lui. Une étape que ses fichiers montrent est
    faite, validée jusqu'à « jusqua » compris (la suite a été faite dessus). Sans fichier : sautée
    si elle n'a ni outil ni demande (SAUTEES), à faire sinon."""
    etat, rang = etat_vide(stem), ETAPES.index(jusqua)
    for i, e in enumerate(ETAPES):
        vus = [(quand(d / n.format(stem=stem)), n.format(stem=stem)) for n in PREUVES.get(e, ())]
        vus = [(t, n) for t, n in vus if t]
        if vus:
            t, n = max(vus)
            etat["etapes"][e] = {"fait": datetime.fromtimestamp(t).astimezone().isoformat(timespec="seconds"),
                                 "mesures": {"recale": n}, "valide": i <= rang or e not in A_VALIDER}
        elif e in SAUTEES:
            etat["etapes"][e]["mesures"] = {"saute": SAUTEES[e]}
    return etat


def etat_a_jour(d, jusqua):
    """ETAT.json recalé sur les fichiers, ou le premier, tiré des fichiers."""
    try:
        etat = lire_etat(d)
    except ValueError as err:
        sys.exit(f"{err} : répare ou supprime ETAT.json, rien écrit")
    if etat is None:
        return depuis_fichiers(d, d.name, jusqua)
    etat["etapes"] = recaler(d, d.name, etat)[0]
    return etat


def valider(a):
    d = trouver(a.stem)
    if a.etape == "etalonnage":
        a.etape = "look"
    if a.etape not in ETAPES:
        sys.exit(f"étape inconnue « {a.etape} » : {', '.join(ETAPES)}")
    etat = etat_a_jour(d, a.etape)
    if not etat["etapes"][a.etape]["fait"]:
        sys.exit(f"{a.etape} n'est pas faite : rien à valider (outils/video statut {shlex.quote(d.name)})")
    etat["etapes"][a.etape]["valide"] = True
    ecrire_etat(d, etat)
    print(f"{d.name} : {a.etape} validée, ETAT.json écrit")


def lufs(f):
    """Sonie intégrée mesurée par ffmpeg (ebur128), None si illisible."""
    r = subprocess.run(["ffmpeg", "-nostdin", "-hide_banner", "-i", str(f), "-map", "0:a:0", "-af", "ebur128",
                        "-f", "null", "-"], capture_output=True, text=True)
    m = re.findall(r"I:\s+(-?[\d.]+) LUFS", r.stderr)
    return float(m[-1]) if m else None


def exporter(a):
    d = trouver(a.stem)
    stem = d.name
    finale = next((d / f"{stem}.{k}.mp4" for k in ("overlays", "motion", "reel") if (d / f"{stem}.{k}.mp4").exists()), None)
    if finale is None:
        sys.exit(f"rien à exporter : ni {stem}.overlays.mp4, ni .motion.mp4, ni .reel.mp4")
    cap = d / "caption.txt"
    if not cap.exists() or not cap.read_text(encoding="utf-8").strip():
        sys.exit(f"pas de caption.txt : la caption passe avant l'export (/sm-video {shlex.quote(stem)})")
    nom = a.nom[:-4] if a.nom.lower().endswith(".mp4") else a.nom
    if not nom or "/" in nom or nom.startswith("."):
        sys.exit(f"nom refusé : « {a.nom} » (un nom court, sans dossier)")
    sonie = lufs(finale)
    if sonie is None or abs(sonie + 14) > 1:
        sys.exit(f"{finale.name} à {sonie} LUFS, la cible est -14 : derush export {shlex.quote(stem)} --from <montage>, puis refais les sous-titres")
    # Tout ce qui se publie vit ensemble dans <STEM>/final/ : la vidéo, la caption, la vignette.
    paquet = d / "final"
    cible = paquet / f"{nom}.mp4"
    if cible.exists() and not a.force and not filecmp.cmp(cible, finale, shallow=False):
        sys.exit(f"{court(cible)} existe déjà et diffère : un autre nom, ou --force")
    etat = etat_a_jour(d, "export")
    paquet.mkdir(exist_ok=True)
    for vieux in paquet.glob("*.mp4"):
        if vieux != cible:
            subprocess.run(["/usr/bin/trash", str(vieux)], check=True)  # un ancien nom part à la Corbeille, jamais rm
    shutil.copy2(finale, cible)
    shutil.copy2(cap, paquet / "caption.txt")
    vignette = d / f"{stem}.thumbnail.png"
    if vignette.exists():
        shutil.copy2(vignette, paquet / "thumbnail.png")
    marquer(etat, "export", {"fichier": court(cible), "depuis": finale.name, "lufs": sonie}, valide=True)
    ecrire_etat(d, etat)
    manque = "" if vignette.exists() else f" ; PAS de vignette ({stem}.thumbnail.png)"
    print(f"{court(paquet)}/ : {cible.name} ({finale.name}, {sonie} LUFS), caption.txt, thumbnail.png{manque} ; publier reste ton geste")


# ---- statut ----

def vue(d):
    stem = d.name
    t = traces(d, stem)
    src, dit, par_nom = prise(d, stem)
    ref = shlex.quote(stem) if par_nom or not src else shell(src)
    try:
        etat = lire_etat(d)
    except ValueError as err:
        v = lecture_ancienne(d, stem, t, src, ref)
        v["etat"] = f"{err} : état déduit des fichiers, rien écrit"
    else:
        v = lecture_etat(d, stem, t, etat, ref) if etat else lecture_ancienne(d, stem, t, src, ref)
    v.update(stem=stem, source=dit, aussi=t["aussi"], activite=t["activite"])
    return v


def dossiers():
    return [d for d in sorted(RACINE.iterdir()) if d.is_dir() and d.name[:1] not in "._"]


def trouver(arg):
    nom = Path(arg.rstrip("/")).name
    if (RACINE / nom).is_dir():
        return RACINE / nom
    if Path(nom).suffix.lower() in VIDEO and (RACINE / Path(nom).stem).is_dir():
        return RACINE / Path(nom).stem
    noms = [d.name for d in dossiers()]
    proches = [n for n in noms if n.startswith(nom)][:3] or difflib.get_close_matches(nom, noms, n=3, cutoff=0.6)
    sys.exit(f"pas de dossier {court(RACINE / nom)}/" + (f" ; proches : {', '.join(proches)}" if proches else ""))


def statut(a):
    if not RACINE.is_dir():
        sys.exit(f"pas de dossier vidéo : {RACINE}")
    if a.stem:
        v = vue(trouver(a.stem))
        lignes = [f"{v['stem']} : {v['resume']}", f"source : {v['source']}"]
        if v["fait"]:
            lignes.append("fait : " + ", ".join(v["fait"]))
        if v["reste"]:
            lignes.append("reste : " + ", ".join(v["reste"]))
        if v["aussi"]:
            lignes.append("aussi : " + ", ".join(v["aussi"]))
        if v.get("liens"):
            lignes.append(v["liens"])
        lignes += [f"attend ton geste : {v['geste']}", f"suite : {v['suite']}", v["etat"]]
        print("\n".join(lignes[:10]))
        return
    vues = [vue(d) for d in dossiers()]
    montrees = sorted((v for v in vues if a.toutes or not v["fini"]), key=lambda v: v["activite"] or 0, reverse=True)
    print(f"{'Toutes les vidéos' if a.toutes else 'En cours'} ({len(montrees)}), de la plus récente à la plus ancienne :")
    for v in montrees:
        print(f"{jour(v['activite']) if v['activite'] else '?':<10}  {v['stem']} : {v['resume']} ; suite : {v['suite']}")
    caches = len(vues) - len(montrees)
    if caches:
        s = "s" if caches > 1 else ""
        print(f"{caches} terminée{s} (exportée{s} ou motion rendu) pas affichée{s} : outils/video statut --toutes")


def main():
    ap = argparse.ArgumentParser(prog="outils/video", description="La chaîne vidéo, une vidéo à la fois.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("statut", help="où en est une vidéo, ou la liste de celles en cours ; n'écrit rien")
    s.add_argument("stem", nargs="?", help="nom du dossier dans videos/ (IMG_4615), ou un chemin vers lui")
    s.add_argument("--toutes", action="store_true", help="liste aussi les vidéos terminées")
    v = sub.add_parser("valide", help="ton OK sur une étape faite ; écrit ETAT.json")
    v.add_argument("stem")
    v.add_argument("etape", help=", ".join(ETAPES) + " (etalonnage = look)")
    x = sub.add_parser("export", help="le paquet à publier dans videos/STEM/final/ ; écrit ETAT.json")
    x.add_argument("stem")
    x.add_argument("nom", help="nom court du fichier exporté (sante-mentale-neurones)")
    x.add_argument("--force", action="store_true", help="remplace un export du même nom qui diffère")
    a = ap.parse_args()
    {"statut": statut, "valide": valider, "export": exporter}[a.cmd](a)


if __name__ == "__main__":
    main()
