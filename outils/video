FINITION = datetime(2026, 1, 1).timestamp()


# ---- ETAT.json : lecture, et écriture ----

def etat_vide(stem):
    return {"version": SCHEMA, "stem": stem, "source_origine": None, "recherche": None,
            "etapes": {e: {"fait": None, "mesures": {}, "valide": False} for e in ETAPES}}


def maintenant():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def marquer(etat, etape, mesures=None, valide=None):
    """L'étape est faite maintenant. valide : true d'office hors A_VALIDER."""
    etat["etapes"][etape] = {"fait": maintenant(), "mesures": mesures or {},
                             "valide": (etape not in A_VALIDER) if valide is None else valide}


def ecrire_etat(d, etat):
    """Écrit ETAT.json d'un coup (fichier temporaire puis renommage). statut ne l'appelle jamais."""
    manque = [e for e in ETAPES if e not in etat.get("etapes", {})]
    if manque or etat.get("stem") != d.name:
        raise ValueError(f"ETAT.json refusé : étapes manquantes {manque}, stem {etat.get('stem')!r} pour {d.name!r}")
    tmp = d / "ETAT.json.tmp"
    tmp.write_text(json.dumps(etat, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, d / "ETAT.json")


def lire_etat(d):
    """ETAT.json complété aux valeurs vides, None s'il n'existe pas. ValueError s'il est illisible."""
    p = d / "ETAT.json"
    if not p.exists():
        return None
    try:
        brut = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        raise ValueError(f"ETAT.json illisible ({e})")
    if not isinstance(brut, dict) or not isinstance(brut.get("etapes", {}), dict):
        raise ValueError("ETAT.json illisible (pas la forme du schéma)")
    etat = etat_vide(d.name)
    for k in ("version", "stem", "source_origine", "recherche"):
        etat[k] = brut.get(k, etat[k])
    for e in ETAPES:
        v = brut["etapes"].get(e) if "etapes" in brut else None
        if isinstance(v, dict):
            etat["etapes"][e].update({k: v[k] for k in ("fait", "mesures", "valide") if k in v})
            if not isinstance(etat["etapes"][e]["mesures"], dict):
                etat["etapes"][e]["mesures"] = {}
    return etat


# ---- Lecture des fichiers ----

def quand(p):
    try:
        return p.stat().st_mtime
    except OSError:
        return None


def jour(t):
    return datetime.fromtimestamp(t).strftime("%Y-%m-%d")


def horodatage(s):
    """« fait » en secondes. Une date seule vaut la fin de ce jour-là, pour ne pas crier au retard."""
    if not isinstance(s, str) or not s:
        return None
    try:
        d = datetime.fromisoformat(s)
    except ValueError:
        return None
    if len(s) == 10:
        d = d.replace(hour=23, minute=59, second=59)
    return d.timestamp()


def court(p):
    s = str(p)
    if s.startswith(str(SM) + "/"):
        return s[len(str(SM)) + 1:]
    return "~" + s[len(HOME):] if s.startswith(HOME + "/") else s


def shell(p):
    """Chemin prêt à coller (le ~ hors des guillemets, pour qu'il s'étende)."""
    s = str(p)
    return "~/" + shlex.quote(s[len(HOME) + 1:]) if s.startswith(HOME + "/") else shlex.quote(s)


def prise(d, stem):
    """(chemin de la prise ou None, ce qu'on en dit, derush la trouve-t-il par son STEM).
    Même règle que derush.sh : _work/source.txt d'abord, et le fichier doit exister."""
    noms = {stem.lower() + x for x in VIDEO}
    ici = next((f for f in sorted(d.iterdir()) if f.is_file() and f.name.lower() in noms), None)
    ptr = d / "_work" / "source.txt"
    if ptr.exists():
        cible = Path(ptr.read_text(encoding="utf-8").strip())
        if cible.is_file():
            return cible, (f"{cible.name}, ici" if cible.parent == d else f"{court(cible)}, hors du dossier"), True
        if ici:
            return ici, (f"{ici.name}, ici ; _work/source.txt vise encore {court(cible)} (absent), "
                         f"donc derush échoue par le nom : la suite passe le chemin"), False
        return None, f"introuvable : _work/source.txt pointe vers {court(cible)}, absent", False
    if ici:
        return ici, f"{ici.name}, ici (pas de _work/source.txt)", False
    return None, "pas de prise dans le dossier", False


def traces(d, stem):
    f = lambda nom: d / nom.format(stem=stem)
    t = {"notes": [n for n in ("FICHE.json", "NOTES-REPRISE.md", "RECHERCHE.md") if f(n).exists()]}
    t["t_notes"] = max((quand(f(n)) for n in t["notes"]), default=None)
    t["prep"] = quand(f("transcript.txt")) if f("_work/aligned.json").exists() else None
    t["render"] = max((x for x in (quand(f("cuts.md")), quand(f("{stem}.derush.mp4"))) if x), default=None)
    for k in ("derush", "reel", "logos", "motion", "repare", "overlays"):
        t[k] = quand(f("{stem}.%s.mp4" % k))
    t["overlays_spec"] = f("overlays/overlays.json").exists()
    t["caption"] = quand(f("caption.txt"))
    t["fcpxml"] = f("{stem}.fcpxml").exists()
    t["motion_dir"] = f("motion").is_dir()
    aussi = []
    if f("CAPTION.md").exists():
        aussi.append("CAPTION.md (ancien nom de caption.txt)")
    aussi += [n for n in ("coupe-serree.md", "logos.json") if f(n).exists()]
    src, _, _ = prise(d, stem)
    autres = []
    for x in sorted(d.iterdir()):
        if x.name.startswith("."):
            continue
        if x.is_dir() and x.name not in DOSSIERS:
            autres.append(x.name + "/")
        elif (x.is_file() and x.suffix.lower() in VIDEO and x != src and x.name not in CONNUS
              and not any(x.name == stem + s for s in SUFFIXES)):
            autres.append(x.name)
            # Une version plus récente que le montage, que derush export ne prendra pas.
            if t["render"] and not t["reel"] and quand(x) > t["render"]:
                t.setdefault("plus_recent", x)
    if autres:
        aussi.append("hors chaîne : " + ", ".join(autres[:4]) + (f" et {len(autres) - 4} de plus" if len(autres) > 4 else ""))
    t["aussi"] = aussi
    t["activite"] = max((quand(x) or 0 for x in d.iterdir() if x.name not in (".DS_Store", "_work")), default=None) or None
    return t


def suite_montage(t, ref):
    """Après le prep : faux départs puis render, jamais un prep relancé (il efface _work/)."""
    if t["prep"]:
        return f"derush words {ref}, écrire retraction_cuts.json, puis derush render {ref}"
    return None


