# Schéma d'ETAT.json, version 1. Le seul endroit qui le définit ; videos/README.md le décrit.
#   version         1
#   stem            nom du dossier videos/<STEM>/, celui du fichier de la prise
#   source_origine  où était la prise avant d'être rangée (ex. ~/Downloads/IMG_4640.MOV)
#   recherche       dossier de recherche, relatif à la racine du dépôt (videos/<STEM>/ ou recherches/<date>-<sujet>)
#   etapes          une entrée par étape de ETAPES : {"fait", "mesures", "valide"}
#     fait          date ET heure ISO 8601 avec fuseau (2026-10-20T14:03:12+02:00), null si pas
#                   faite. L'heure compte : statut la compare à la date des fichiers.
#     mesures       ce que l'étape a mesuré, libre par étape. "saute": "<raison>" = étape passée
#                   exprès (repare quand le diag est bon, medias sans référence).
#     valide        ton OK. false sur une étape faite = elle attend ton geste. marquer() met true
#                   d'office hors A_VALIDER.
SCHEMA = 1
ETAPES = ("diag", "repare", "montage", "look", "medias", "motion", "overlays", "caption", "export")
# le plan : les coupes, la planche des médias, le motion ; puis les sous-titres et la caption
A_VALIDER = ("montage", "medias", "motion", "overlays", "caption")
# Étapes OPTIONNELLES : aucun outil derrière (diag, repare, medias). Jamais la « suite », jamais
# bloquantes ; elles restent dans ETAT.json pour qu'un état ancien se lise sans casser.
OPTIONNELLES = ("diag", "repare", "medias")
OPTION_TXT = "optionnelle, pas d'outil"
NOMS = {"look": "étalonnage"}  # nom affiché ; la clé d'ETAT.json et de « valide » reste « look »
# Le look se fixe une fois pour toutes (outils/look.py fixe) : LOOK.json fait preuve pour toutes les vidéos.
LOOK_JSON = SM / "outils" / "looks" / "LOOK.json"
TOLERANCE = 60  # s : l'écrivain pose ETAT.json juste après les fichiers de son étape

# Avec ETAT.json, le fichier qui montre chaque étape. look : aucun fichier tant que derush export ne
# pose pas le look : LOOK.json (outils/looks/), écrit par look.py fixe, le montre. diag et export n'ont aucun fichier dans le dossier : ETAT.json seul.
PREUVES = {
    "repare": ("{stem}.repare.mp4",),
    "montage": ("cuts.md", "{stem}.derush.mp4", "{stem}.reel.mp4"),
    "medias": ("medias/MEDIAS.json",),
